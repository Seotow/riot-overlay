{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "src",
    "server",
    "shared",
    "tests",
    "collector/adapter",
    "collector/validation",
    "collector/scripts/validate-project-live.ts",
    "collector/scripts/probe-basic-fields.ts",
    "collector/scripts/check-accountless-offline.ts",
    "collector/scripts/capture-match.ts",
    "collector/supervisor/supervisor.ts"
  ]
}
