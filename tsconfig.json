{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "server",
    "shared",
    "tests",
    "Collector/adapter",
    "Collector/validation",
    "Collector/scripts/validate-project-live.ts",
    "Collector/scripts/probe-basic-fields.ts",
    "Collector/scripts/check-accountless-offline.ts",
    "Collector/scripts/capture-match.ts",
    "Collector/runtime/supervisor.ts"
  ]
}
