      "label": "Script class",
      "detail": "Required scene script class",
      "apply": "final class Script : SceneScript\n{\n    Script(Entity@ owner)\n    {\n        super(owner);\n    }\n\n    void onUpdate(float dt) override\n    {\n        ${}\n    }\n}"
