    {
      "label": "game event callback",
      "detail": "Handle every game notification",
      "apply": "void onGameEvent(GameEvent@ event) override\n{\n    if (event is null) return;\n    ${}\n}"
    },
    {
      "label": "champion kill callback",
      "detail": "Handle champion deaths",
      "apply": "void onChampionKill(GameEvent@ event) override\n{\n    Hero@ killer = event.killer;\n    Hero@ victim = event.victim;\n    ${}\n}"
    },
