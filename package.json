{
  "name": "riot-overlay",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "start:collector": "tsx server/index.ts --production --collector",
    "start:collector:no-auth": "tsx server/index.ts --production --collector-accountless",
    "capture:collector": "tsx collector/scripts/capture-match.ts",
    "capture:collector:mark": "tsx collector/scripts/capture-match.ts --mark",
    "capture:collector:stop": "tsx collector/scripts/capture-match.ts --stop",
    "engine:lol": "tsx scripts/dev/start-independent-engine.ts",
    "collector:inspect": "tsx scripts/inspect/inspect-collector-adapter.ts",
    "collector:validate": "tsx collector/scripts/validate-project-live.ts",
    "collector:probe-fields": "tsx collector/scripts/probe-basic-fields.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx tests/system.integration.ts",
    "test:collector": "tsx tests/collector-project.integration.ts",
    "test:collector-capture": "tsx tests/collector-capture.integration.ts",
    "test:collector-validation": "tsx tests/collector-validation.integration.ts",
    "valorant:init": "node modules/valorant/runtime/cli.mjs init",
    "valorant:doctor": "node modules/valorant/runtime/cli.mjs doctor",
    "valorant:collector": "node modules/valorant/runtime/cli.mjs set-collector",
    "start:all": "node scripts/dev/start-studio-valorant.mjs",
    "start:valorant": "node modules/valorant/runtime/cli.mjs start",
    "build:valorant": "npm --prefix modules/valorant/backend run build && npm --prefix modules/valorant/frontend run build && npm --prefix modules/valorant/frontend-val26 run build",
    "test:valorant": "node --test modules/valorant/tests/*.test.mjs",
    "assets:sync": "node scripts/assets/sync-assets.mjs",
    "assets:sync:live": "node scripts/assets/sync-live-assets.mjs",
    "capture:live": "node scripts/capture/capture-live-session.mjs",
    "capture:lb": "node scripts/capture/capture-leaguebroadcast.mjs",
    "capture:mark": "node scripts/capture/mark-capture-event.mjs",
    "capture:analyze": "node scripts/capture/analyze-capture-events.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "probe:tracking": "tsx scripts/inspect/probe-tracking.ts"
  },
  "keywords": [],
  "author": "",
